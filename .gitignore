# Secrets — never commit
.env
*.pem
*.key
credentials*

# AWS account ID / resource ARNs — never commit (§31c).
# Rooted here so the vendor's nested .gitignore cannot re-un-ignore them.
# deployed-state.json is a regenerable CLI output; aws-targets.json is a
# required input config committed as aws-targets.json.example instead.
deploy/spike_b/porchlightspike/agentcore/.cli/deployed-state.json
deploy/spike_b/porchlightspike/agentcore/aws-targets.json

# Hunter Lambda working artifacts: the IAM policy/trust JSON carry the account ID
# in resource ARNs, and the build outputs are regenerable. Templates committed as
# *.example instead (§31c pattern). handler.py + build.py ARE committed (source).
deploy/hunter_lambda/_policy.json
deploy/hunter_lambda/_trust.json
deploy/hunter_lambda/hunter_lambda.zip
deploy/hunter_lambda/_invoke_out.json
deploy/hunter_lambda/_stage/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
.venv/
.hypothesis/
.pytest_cache/

# Build artifacts
_staging/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
