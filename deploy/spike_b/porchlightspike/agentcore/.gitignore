# Secrets (local environment files are never committed)
.env.local

# CDK Build Artifacts
cdk/cdk.out/
cdk/node_modules/

# CLI Internals
.cli/*

# Ephemeral Staging
.cache/*

# NOTE (§31c): the vendor default un-ignored .cli/deployed-state.json here
# ("!.cli/deployed-state.json"). We REMOVED that negation. The file carries our
# AWS account ID in resource ARNs and this repo is public; a nested negation was
# overriding the root .gitignore and re-tracking it. deployed-state.json is a
# regenerable CLI output and stays ignored. Do not restore the negation.
