# Porch Light — copy to .env and fill in. NEVER commit .env.
# See docs/agenda-watch-decisions.md §26d for the secrets split.

# ---- Local development (docker compose up -d) ----
DATABASE_URL=postgresql://porchlight:porchlight_local_only@localhost:5432/porchlight

# ---- Production (Aurora Serverless v2 PostgreSQL, via RDS Data API — §33) ----
# The web layer reaches Aurora over the RDS Data API (HTTPS + IAM), not a VPC
# connection string. Set the cluster ARN and the Secrets Manager secret ARN;
# there is no raw postgresql:// URL in production. Credential-free placeholders:
# AURORA_CLUSTER_ARN=arn:aws:rds:us-east-1:<AWS_ACCOUNT_ID>:cluster:porchlight-<env>
# AURORA_SECRET_ARN=arn:aws:secretsmanager:us-east-1:<AWS_ACCOUNT_ID>:secret:porchlight-<env>-db
# AURORA_DATABASE=porchlight

# ---- AWS ----
AWS_REGION=us-east-1
# Vercel holds credentials scoped to invoking ONLY the watcher agent.
# The hunter and extractor execution roles are separate and never reach Vercel.
# AGENTCORE_WATCHER_ARN=

# ---- Runtime ----
ENV=dev
CITY_TIMEZONE=America/Los_Angeles

# ---- Model (Spec 0: Nova Lite; Spec 3 decides production model) ----
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Contact URL published in our user-agent, per the good-citizen rule (§7).
FETCH_USER_AGENT_CONTACT=https://github.com/earlgreyhot1701D/porch-light
